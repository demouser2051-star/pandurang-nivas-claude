{#
/**
 * @file
 * The primary navigation, matching the markup the original stylesheet expects:
 * a bare <ul> inside #main-nav, each link carrying a Font Awesome icon.
 */
#}
{% import _self as menus %}
{{ menus.items(items, attributes, 0) }}

{% macro items(items, attributes, menu_level) %}
  {% import _self as menus %}

  {# Icons are matched on the link's route so editors can rename menu items. #}
  {% set icons = {
    '<front>': 'fa-home',
    'pandurang.home': 'fa-home',
    'entity.node.canonical': 'fa-info-circle',
    'pandurang.family_tree_page': 'fa-tree',
    'view.pn_gallery.page_1': 'fa-camera',
    'view.pn_events.page_1': 'fa-calendar-alt',
    'contact.site_page': 'fa-envelope',
    'user.page': 'fa-user',
  } %}

  {% if items %}
    <ul{{ menu_level == 0 ? attributes.removeClass('menu') : create_attribute({'class': ['submenu']}) }}>
      {% for item in items %}
        {%- set route = item.url.isRouted ? item.url.getRouteName() : '' -%}
        {%- set icon = item.icon|default(icons[route]|default('fa-angle-right')) -%}

        <li{{ item.attributes.addClass(item.in_active_trail ? 'is-active-trail') }}>
          <a href="{{ item.url }}"{{ item.in_active_trail ? ' class="active"' : '' }}>
            <i class="fas {{ icon }} nav-icon" aria-hidden="true"></i>
            <span class="marathi-font">{{ item.title }}</span>
          </a>

          {% if item.below %}
            {{ menus.items(item.below, attributes, menu_level + 1) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
