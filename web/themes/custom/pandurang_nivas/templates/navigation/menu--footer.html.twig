{#
/**
 * @file
 * Footer quick links.
 *
 * One list, split into two columns by CSS. Splitting it into two <ul>s in the
 * template does not work here: Drupal wraps every menu block in its own
 * <nav><div> markup, so the two lists never end up as siblings the grid on
 * .footer-links-columns can lay out.
 */
#}
{% if items %}
  <ul class="footer-links footer-links--split">
    {% for item in items %}
      <li>
        <a href="{{ item.url }}">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <span class="marathi-font">{{ item.title }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
