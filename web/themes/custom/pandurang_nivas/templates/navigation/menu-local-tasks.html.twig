{#
/**
 * @file
 * Admin tabs (View / Edit / Responses / Translate).
 *
 * stable9 renders these as a bare <ul>; naming the lists lets the theme style
 * them as pills rather than bullets.
 */
#}
{% if primary %}
  <nav class="tabs tabs--primary" role="navigation" aria-label="{{ 'Primary tabs'|t }}">
    <ul class="tasks tasks--primary">{{ primary }}</ul>
  </nav>
{% endif %}

{% if secondary %}
  <nav class="tabs tabs--secondary" role="navigation" aria-label="{{ 'Secondary tabs'|t }}">
    <ul class="tasks tasks--secondary">{{ secondary }}</ul>
  </nav>
{% endif %}
